# ==============================================================================
# Enterprise Knowledge & Compliance Copilot — Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL + pgvector Database
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql://raguser:local_dev_password_change_me@localhost:5432/knowledge_copilot
# Docker compose internal network:
# DATABASE_URL=postgresql://raguser:local_dev_password_change_me@postgres:5432/knowledge_copilot

# ------------------------------------------------------------------------------
# 2. Local Ollama LLM & Embedding Server
# ------------------------------------------------------------------------------
# Host desktop Ollama:
OLLAMA_BASE_URL=http://localhost:11434
# When running app inside Docker and Ollama on host desktop:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Generation Models
GENERATION_MODEL=qwen3:4b
FAST_GENERATION_MODEL=qwen2.5-coder:1.5b
MODEL_PROFILE=standard
GENERATION_NUM_PREDICT=200

# Residency & Performance (keep models in memory to avoid cold reloads)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=2

# ------------------------------------------------------------------------------
# 3. Retrieval & Ranking Configuration
# ------------------------------------------------------------------------------
DEFAULT_TOP_K=3
RELEVANCE_THRESHOLD=0.50
ENABLE_QUERY_REWRITING=false

# Optional Second-Stage Reranker (Phase 5)
# Set to 'true' to enable cross-encoder / heuristic candidate reranking
RERANKER_ENABLED=false
# Options: 'heuristic' (0ms overhead), 'ollama' (local LLM scoring), 'cross_encoder' (requires sentence-transformers)
RERANKER_TYPE=heuristic
RERANKER_MODEL=qwen2.5-coder:1.5b

# ------------------------------------------------------------------------------
# 4. Security & Cookie Settings
# ------------------------------------------------------------------------------
# Set COOKIE_SECURE=true in production (forces HTTPS-only cookies)
COOKIE_SECURE=false
SESSION_DURATION_HOURS=24
REQUEST_TIMEOUT_SECONDS=120.0
