DATABASE_URL=postgresql://raguser:YOUR_PASSWORD@localhost:5432/knowledge_copilot
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Generation Models and Latency Optimization
GENERATION_MODEL=qwen3:4b
FAST_GENERATION_MODEL=qwen2.5-coder:1.5b
GENERATION_NUM_PREDICT=200
DEFAULT_TOP_K=3

# Model Residency & Performance (Phase 8)
# Keep models resident in memory to eliminate cold-start reload latency
OLLAMA_KEEP_ALIVE=30m
# Set OLLAMA_MAX_LOADED_MODELS=2 in your environment when starting Ollama:
#   Windows PowerShell: $env:OLLAMA_MAX_LOADED_MODELS="2"; ollama serve
#   Linux / Mac: OLLAMA_MAX_LOADED_MODELS=2 ollama serve
OLLAMA_MAX_LOADED_MODELS=2
MODEL_PROFILE=standard

